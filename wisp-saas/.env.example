# Copy to .env (gitignored) and fill in. Everything marked REQUIRED IN
# PRODUCTION comes from you; nothing here is a real credential.

# ── Core ─────────────────────────────────────────────
APP_ENV=development                 # production on the live server
# Encryption of PPPoE passwords / router + Daraja keys. Use ONE of:
LOCAL_KEK=                          # openssl rand -base64 32   (dev / self-hosted)
KMS_KEY_ID=                         # alias/wisp-tenant-secrets (AWS; needs AWS_* creds)
RADIUS_SECRET_SEED=                 # openssl rand -hex 32 — never change after routers exist
RADIUS_API_TOKEN=                   # openssl rand -hex 24 — FreeRADIUS -> cmd/radius

# ── Public URLs ──────────────────────────────────────
PUBLIC_API_URL=http://localhost:8080          # https://api.<your domain>
PORTAL_BASE_URL=http://localhost:3010/portal  # https://portal.<your domain>
DASHBOARD_URL=http://localhost:3010           # https://app.<your domain>
ALLOWED_ORIGINS=http://localhost:3010

# docker-compose.prod.yml + Caddy
API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com
PORTAL_DOMAIN=portal.example.com
ACME_EMAIL=you@example.com
POSTGRES_OWNER_PASSWORD=                      # openssl rand -hex 16
APP_DB_PASSWORD=                              # openssl rand -hex 16

# ── M-Pesa (Daraja) — REQUIRED IN PRODUCTION ─────────
MPESA_ENV=sandbox                             # production once Safaricom approves your app
MPESA_PLATFORM_CONSUMER_KEY=
MPESA_PLATFORM_CONSUMER_SECRET=
MPESA_PLATFORM_PASSKEY=
MPESA_PLATFORM_SHORTCODE=174379               # your shortcode; WISPs pay their subscription here
MPESA_ALLOWED_IPS=                            # Safaricom callback IPs, comma-separated (empty = allow all, dev only)
SUBSCRIPTION_PRICE_KES=1500
SMS_CREDIT_PRICE_CENTS=100
# Set to yes only once Safaricom has approved platform-mode STK in writing.
SAFARICOM_PLATFORM_APPROVED=no
TRUST_PROXY_HEADERS=false                     # true behind Caddy (prod compose sets it)
TRUST_CLOUDFLARE=false                        # true only if the origin accepts Cloudflare traffic alone

# ── Africa's Talking SMS ─────────────────────────────
AT_USERNAME=sandbox
AT_API_KEY=                                   # empty = SMS are logged, not sent
AT_SENDER=

# ── WireGuard tunnel ─────────────────────────────────
WG_TUNNEL_CIDR=10.200.0.0/16
WG_SERVER_PRIVATE_KEY=                        # wg genkey            (wg-gateway only)
WG_SERVER_PUBLIC_KEY=                         # echo <private> | wg pubkey
WG_SERVER_ENDPOINT=vpn.example.com:51820      # public host:port routers dial
ROUTER_API_PORT=443
ROUTER_API_INSECURE=true                      # router certs are self-signed; traffic is inside WireGuard
